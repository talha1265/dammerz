# ==============================================================================
# BizzUp AI — Production & Cloud Deployment Environment Variables
# Copy these values into your Vercel / Railway / AWS Environment Variables panel
# ==============================================================================

# Core Deployment Settings
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com
PORT=3000

# Security & Master Auth
# Generate random 32+ character key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_secure_random_64_char_secret_key
# Set your private Master Admin Security PIN (Change from default 9922)
ADMIN_SECURITY_PIN=replace_with_your_private_master_pin

# ------------------------------------------------------------------------------
# 1. Neon PostgreSQL Database (Production Branch)
# Create a dedicated production database on neon.tech with automated backups
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-your-prod-id-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=postgresql://user:password@ep-your-prod-id-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway (Live Mode for Subscriptions)
# Get from Razorpay Dashboard -> Settings -> API Keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_your_key_id
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_key

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Model
# Obtain from Google AI Studio / Google Cloud Console (with Billing Enabled)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_production_google_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. Meta WhatsApp Business Cloud API
# Obtain from Meta Developers Portal (developers.facebook.com) -> WhatsApp
# ------------------------------------------------------------------------------
WHATSAPP_TOKEN=your_meta_system_user_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=bizzup_webhook_verify_token_secure_string

# ------------------------------------------------------------------------------
# 5. Production Mode Settings
# Set to false in production to ensure live transactions and real API responses
# ------------------------------------------------------------------------------
ENABLE_MOCK_FALLBACK=false
